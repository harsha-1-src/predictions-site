# Copy to .env (gitignored) and fill in. Process environment variables
# always win over values in this file. Parsed by daily.py's tiny stdlib
# KEY=VALUE reader: blanks, #comments and malformed lines are ignored,
# surrounding quotes are stripped.

# Dead-man switch: pinged with one GET at the end of a fully successful
# live daily run (never on a failed or dry run). Leave empty to disable.
HEALTHCHECK_URL=

# Disk-space guard threshold in GiB (default 2). daily.py aborts loudly
# before doing any work when the volume has less free space than this.
# MIN_FREE_GB=2
